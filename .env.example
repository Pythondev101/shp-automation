# Copy this file to .env and fill in the values. .env is git-ignored - never commit it.
# Variables already set in the environment (e.g. by CI) take precedence over .env.
# In GitHub Actions the same three names are repository secrets; no other secret is needed.

# SHP application under test
SHP_BASE_URL=http://52.44.166.66:8080

# Dedicated automation account used to log in (SHP_USERNAME is the account's email address).
# Use a valid account only: SHP may deactivate an account after 3 wrong passwords.
SHP_USERNAME=
SHP_PASSWORD=
