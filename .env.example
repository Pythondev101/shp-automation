# Copy this file to .env and fill in the values. .env is git-ignored - never commit it.
# Variables already set in the environment (e.g. by CI) take precedence over .env.
# In GitHub Actions the same three names are repository secrets; no other secret is needed.

# SHP application under test
SHP_BASE_URL=http://52.44.166.66:8080

# Dedicated automation account used to log in (SHP_USERNAME is the account's email address).
# Use a valid account only: SHP may deactivate an account after 3 wrong passwords.
SHP_USERNAME=
SHP_PASSWORD=

# Sandbox test cards for the Card Setting tests (My Account -> Card Setting).
# The application uses Stripe in TEST mode (pk_test_...). Use Stripe's published test
# card numbers only - NEVER a real card, and never commit real values anywhere.
# Leave empty to skip the Card Setting card tests (they are skipped, not failed).
SHP_TEST_CARD_NUMBER=
SHP_TEST_CARD_EXPIRY=
SHP_TEST_CARD_BRAND=
SHP_TEST_CARD_2_NUMBER=
SHP_TEST_CARD_2_EXPIRY=
SHP_TEST_CARD_2_BRAND=
SHP_TEST_CARD_CVC=

# Sandbox SMTP values for the SMTP Settings tests (My Account -> SMTP Settings).
# The tests only store a configuration row: nothing is ever sent and no mail server is
# contacted, so these need not be a working mailbox - NEVER a production mail account.
# Every one is optional; left empty, the framework uses a fake .test host and generates a
# random password per run (see framework/config.py get_sandbox_smtp). The password is never
# logged, printed or written to a report.
SHP_TEST_SMTP_HOST=
SHP_TEST_SMTP_PORT=
SHP_TEST_SMTP_PASSWORD=
SHP_TEST_SMTP_FROM_EMAIL=
SHP_TEST_SMTP_FROM_NAME=
# Encryption option value: tls, ssl or none. Prefix of the unique SMTP username each test
# creates and deletes again - only rows carrying it are ever deleted.
SHP_TEST_SMTP_ENCRYPTION=
SHP_TEST_SMTP_USERNAME_PREFIX=
